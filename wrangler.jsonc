{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prospect-line-webhook",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-12",
  "triggers": {
    "crons": ["0 18 * * *", "2 18 * * *", "4 18 * * *", "6 18 * * *"]
  },
  "exports": {
    "ReservationOutbox": { "type": "durable-object", "storage": "sqlite" },
    "AvailabilitySnapshot": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
