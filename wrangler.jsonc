{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prospect-line-webhook",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-12",
  "vars": { "TRIAL_CONFIG_BRIDGE_ONLY": "true" },
  "triggers": {
    "crons": []
  },
  "exports": {
    "ReservationOutbox": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "AvailabilitySnapshot": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
